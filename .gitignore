# Rust build artifacts
/target

# Vendored reference trees (read-only dev aids; large; must not be committed)
/reference

# Local release binaries staged into the Docker build context (don't commit)
/outlay
/outlay-shim

# Local env files (may contain private keys)
.env
.env.local

# Bundled in-process relay SQLite backend (OUTLAY_BUNDLED_BACKEND=sqlite)
outlay-relay.db*
